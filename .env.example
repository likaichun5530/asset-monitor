# 前端环境变量示例
# 复制为 .env.local 后填写

# 可选：前后端分离部署时填写 API 地址；同域部署不需要配置
VITE_API_BASE=http://localhost:8787

# 以下变量仅配置在 Vercel 或 server/.env，切勿使用示例值作为真实凭据。
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
JWT_SECRET=
AUTH_USERNAME=
# SystemSettings 首次初始化前的兼容登录密码；应用不会将该明文值写入 Google Sheets。
AUTH_PASSWORD=
CRON_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
GEMINI_API_KEY=
# 可选：Gemini 单次回答输出上限，允许 1024～32768；无效值回退为 8192。
GEMINI_MAX_OUTPUT_TOKENS=8192
# 可选：Gemini 3.x 推理级别，支持 low / medium / high；默认 low 以降低首包延迟。
GEMINI_THINKING_LEVEL=low
AI_ASSISTANT_ENABLED=true
