# 前端环境变量示例
# 复制为 .env.local 后填写

# 可选：前后端分离部署时填写 API 地址；同域部署不需要配置
VITE_API_BASE=http://localhost:8787

# 以下变量仅配置在 Vercel 或 server/.env，切勿使用示例值作为真实凭据。
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
JWT_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=
CRON_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
AI_ASSISTANT_ENABLED=true
