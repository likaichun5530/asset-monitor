# Google Sheets 配置
# 1. 在 Google Cloud Console 创建服务账号，启用 Google Sheets API
# 2. 下载 JSON 密钥，将其中的 client_email 和 private_key 填入
# 3. 把服务账号邮箱分享给你的 Google Sheets（编辑权限）

# Google Sheets ID（从表格 URL 中获取）
SPREADSHEET_ID=your-spreadsheet-id-here

# 服务账号邮箱
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com

# 私钥（注意：保留 -----BEGIN PRIVATE KEY----- 头尾，换行用 \n 表示）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 后端端口
PORT=8787

# 登录配置
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# 手动调用 /api/snapshot-auto 时使用
CRON_SECRET=replace-with-a-long-random-string
