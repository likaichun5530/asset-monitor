# Google Sheets 配置
# 1. 在 Google Cloud Console 创建服务账号，启用 Google Sheets API
# 2. 下载 JSON 密钥，将其中的 client_email 和 private_key 填入
# 3. 把服务账号邮箱分享给你的 Google Sheets（编辑权限）

# Google Sheets ID（从表格 URL 中获取）
SPREADSHEET_ID=

# 服务账号邮箱
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 私钥（注意：保留 -----BEGIN PRIVATE KEY----- 头尾，换行用 \n 表示）
GOOGLE_PRIVATE_KEY=

# 后端端口
PORT=8787

# 登录配置
AUTH_USERNAME=
# SystemSettings 首次初始化前的兼容登录密码；应用不会将该明文值写入 Google Sheets。
AUTH_PASSWORD=
# 必填：使用密码管理器生成足够长的随机值；未配置时服务会拒绝签发和验证 JWT。
JWT_SECRET=

# 手动调用 /api/snapshot-auto 时使用
# 必填：使用与 JWT_SECRET 不同的长随机值。
CRON_SECRET=

# DeepSeek AI 资产助手
# 在 https://platform.deepseek.com/ 创建 API Key；密钥只能保存在服务端
DEEPSEEK_API_KEY=

# 可选：使用 DeepSeek 官方接口时通常无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Google Gemini AI 资产助手
# 在 Google AI Studio 创建 API Key；密钥只能保存在服务端
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# 可选：服务端总开关。设为 false 时所有用户都无法调用 AI
AI_ASSISTANT_ENABLED=true
